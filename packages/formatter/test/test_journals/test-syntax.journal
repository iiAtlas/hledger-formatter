; This is a comment - should be highlighted in green

; Testing !include statements - should be highlighted as keywords
!include 01-jan.journal
!include expenses/2023.journal
!include ../common/accounts.journal

; Reconciled transaction (with *) - normal color
2023-01-01 * Opening Balance
    assets:bank:checking:personal        $1000.00
    equity:opening:balances              -$1000.00

; Unreconciled transaction (no status) - highlighted in red/italic
2023-01-03 Unreconciled Coffee Purchase
    expenses:dining:coffee                $5.25
    assets:cash                          -$5.25

; Pending transaction (with !) - highlighted in orange
2023-01-05 ! Grocery Store
    expenses:food:groceries:produce      $45.50
    expenses:food:groceries:dairy         $20.00
    assets:bank:checking:personal        -$65.50

; Another unreconciled transaction
2023-01-10 Coffee Shop
    expenses:dining:coffee                $4.75
    assets:cash                          -$4.75

; Testing different account depths
2023-01-15 Complex Transaction
    assets:investments:stocks:technology:apple    10 AAPL
    assets:bank:savings                          -$1500.00
    expenses:fees:brokerage                       $9.95
    
; Testing negative amounts
2023-01-20 Rent Payment
    expenses:housing:rent                 $800.00
    assets:bank:checking                 -$800.00

; Testing indented comment within reconciled transaction
2025-07-02 * atlas-playground.xyz domain
  ; domain renewal, receipt added
  expenses:software:domains               $11.84
  equity:owner:contributions             -$11.84

; Testing inline comments after amounts (unreconciled)
2023-02-01 Test Transaction
    expenses:test                        $50.00  ; this is an inline comment
    assets:bank                         -$50.00  ; another comment

; Testing tags - only recognized inside ; comments on transactions, postings and directives
2023-03-01 * Website Development  ; project:mugsly, client: abc
    income:consulting                   -$500.00
    assets:bank:checking                 $500.00  ; hours:12

; Tag on its own comment line within a transaction
2023-03-05 ! Design Work
    ; receipt added, project: client-abc
    expenses:contractors                  $200.00
    assets:bank:checking                 -$200.00

; Built-in tags are highlighted differently only where hledger acts on them:
; date:/date2: in posting comments, type: in account directive comments
account assets:bank:checking  ; type: A
account assets:bank:savings
    ; type: A

; date: and type: here are transaction comments, so they're normal tags
2023-03-10 Coffee Meeting  ; project:mugsly, date:2023-03-11
    ; receipt date: 2023-03-09, type: meal
    expenses:meetings                      $15.00  ; date:2023-03-12
    ; date2:2023-03-13
    assets:cash                           -$15.00

; Tags in top-level comments are ignored by hledger, so not highlighted: project:none